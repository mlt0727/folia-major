{
  "ignoreCommand": "git rev-parse --verify -q HEAD^ >/dev/null && git diff --quiet HEAD^ HEAD -- . ':(exclude)docs/CODEMAP.md'",
  "rewrites": [
    { "source": "/api/qq-audio/sjy6/:path*", "destination": "http://sjy6.stream.qqmusic.qq.com/:path*" },
    { "source": "/api/qq-audio/dl/:path*", "destination": "http://dl.stream.qqmusic.qq.com/:path*" },
    { "source": "/api/qq/:path*", "destination": "/api/qq?path=/:path*" }
  ]
}
